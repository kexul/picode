.vscode/**
src/**
scripts/**
tsconfig*.json
node_modules/**
out/**/*.map
*.vsix
**/*.ts

# 插件包里只装插件那一侧：后端编在 out/server（它是独立进程，靠 npm i -g . 装的那份跑，
# 插件从不加载它）；bin/pichat.js 是给 npm 装命令行用的，也不进插件包。
out/server/**
bin/**

# 界面文件也不进插件包：面板的界面从后端现取（见 chatHtml.ts），插件自己不读 media/。
# 它只在后端那份安装里有用，npm i -g . 时靠 package.json 的 files 带上。
media/**

# 开发仓库文件，不打进插件
.git/**
.gitignore
.npmrc
build.bat
.github/**
dev/**
AGENTS.md
