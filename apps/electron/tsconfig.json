{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "outDir": "out",
    "rootDir": "../..",
    "lib": ["ES2021", "DOM"],
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "../../src/shared/**/*.ts", "../../src/chat-ui/**/*.ts"],
  "exclude": ["node_modules", "renderer", "scripts"]
}
