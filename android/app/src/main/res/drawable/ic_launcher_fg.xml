<?xml version="1.0" encoding="utf-8"?>
<!-- app 的图标就是网页那颗标记（网页端那枚 favicon，见 src/pageHtml.ts 的 PAGE_ICON_SVG）：
     浅色底（见 values/colors.xml 的 ic_launcher_bg）+ 这枚标记（黑的 + 右下那根红的）。
     标记只占中间 56（自适应图标 108 里那圈 72 是各家桌面保证露出来的那一块，圆的遮罩也裁不到它）：
     外圈会被桌面按自己的形状裁掉，所以图形不敢贴边。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.1"
        android:scaleY="0.1"
        android:translateX="26"
        android:translateY="26">
        <!-- 左上那块（竖的长条 + 上面横出来的一条） -->
        <path
            android:fillColor="#111111"
            android:pathData="M420,280 L280,280 L280,140 L0,140 L0,0 L420,0 Z" />
        <!-- 左下那块（横过来的一条 + 中间竖上去的一根） -->
        <path
            android:fillColor="#111111"
            android:pathData="M140,560 L0,560 L0,140 L140,140 L140,280 L280,280 L280,420 L140,420 Z" />
        <!-- 右下那根是红的 -->
        <path
            android:fillColor="#E53935"
            android:pathData="M560,560 L420,560 L420,280 L560,280 Z" />
    </group>
</vector>
