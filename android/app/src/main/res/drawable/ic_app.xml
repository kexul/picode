    <group
        android:pivotX="280"
        android:pivotY="280"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- 左上那一块（上面一条横条 + 右边一截） -->
        <path
            android:fillColor="#111111"
            android:pathData="M420,280 L280,280 L280,140 L0,140 L0,0 L420,0 Z" />
        <!-- 右下角那根竖线：一直是红的 -->
        <path
            android:fillColor="#E53935"
            android:pathData="M560,560 L420,560 L420,280 L560,280 Z" />
        <!-- 左下那一块（阶梯状） -->
        <path
            android:fillColor="#111111"
            android:pathData="M140,560 L0,560 L0,140 L140,140 L140,280 L280,280 L280,420 L140,420 Z" />
