// 后端（pichat）那一侧：只编 serverMain.ts 自己能 import 到的文件。
// 和插件侧各自编各自的（两边会各有一份 serverPaths / serverState / renderHtml），
// 这样插件包里干净，后端装在别处也能单独跑。
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/server"
  },
  // src/diffMatchPatch.js 是照抄来的 JS（Google 的 diff-match-patch）：后端要用它，
  // 但它从 serverMain.ts 那里 import 到的是旁边的 .d.ts（类型），所以得单独列进来才编得出。
  "include": ["src/serverMain.ts", "src/diffMatchPatch.js"]
}
