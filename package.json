{
  "name": "pi-chat",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "compile": "npm --prefix apps/vscode run build",
    "watch": "npm --prefix apps/vscode run watch",
    "build:vscode": "npm --prefix apps/vscode run build",
    "build:electron": "npm --prefix apps/electron run build",
    "watch:vscode": "npm --prefix apps/vscode run watch",
    "watch:electron": "npm --prefix apps/electron run watch",
    "start:electron": "npm --prefix apps/electron run start",
    "package:vscode": "npm --prefix apps/vscode run package",
    "dist:electron": "npm --prefix apps/electron run dist",
    "analyze": "node scripts/analyze-reuse.js",
    "analyze:json": "node scripts/analyze-reuse.js --json"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
